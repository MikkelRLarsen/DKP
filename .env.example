POSTGRES_DB=dkp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
PGADMIN_DEFAULT_EMAIL=admin@coffecottage.dk
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
DISCORD_CLIENT_ID=change-this-client-id
DISCORD_CLIENT_SECRET=change-this-client-secret
DISCORD_GUILD_ID=1505886353131311136
DISCORD_OFFICER_USER_IDS__0=change-this-discord-user-id
# Discord bot configuration. The bot token is from Developer Portal > Bot.
DISCORD_BOT_TOKEN=change-this-discord-bot-token
# Discord Developer Portal > General Information > Application ID.
DISCORD_APPLICATION_ID=change-this-discord-application-id
# The bot's guild-specific command registration target.
# DISCORD_GUILD_ID is also used by the webapp's guild-membership check.
# Use 1505886353131311136 for the current development guild.
# Base URL only; the bot appends /api/bot/health and /api/bot/dkp.
# Use https://localhost:7179 when the bot runs locally outside Docker.
DKP_BOT_API_URL=http://dkp:8080
# Internal shared secret between DKP webapp/API and the bot. This is not a Discord token.
DKP_BOT_API_SECRET=change-this-long-random-secret
DISCORD_REDIRECT_URI=https://wowforever.coffecottage.dk/signin-discord
DKP_HOST=wowforever.coffecottage.dk
PGADMIN_HOST=pgadmin.coffecottage.dk
LETSENCRYPT_EMAIL=admin@coffecottage.dk
WATCHTOWER_POLL_INTERVAL=300
NGROK_URL=https://little-stylishly-blot.ngrok-free.dev
NGROK_AUTHTOKEN=change-this-ngrok-authtoken
