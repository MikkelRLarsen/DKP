@page "/admin/bulletin"
@attribute [Authorize(Roles = "Officer")]
@using DKP.Facade.Commands
@using DKP.Facade.Contracts
@using DKP.Facade.Queries
@inject IBulletinQueries BulletinQueries
@inject IBulletinCommands BulletinCommands
@inject IBulletinTemplateQueries TemplateQueries
@inject IBulletinTemplateCommands TemplateCommands
@inject NotificationService NotificationService

<PageTitle>Bulletin Administration</PageTitle>
<RadzenStack Gap="1rem">
<h1>Bulletin Board Administration</h1>
<RadzenAccordion Multiple="true"><Items>
<RadzenAccordionItem Text="Template administration" Icon="content_copy">
<RadzenCard><RadzenStack Gap=".75rem">
<RadzenText Text="Bulletin templates" TextStyle="TextStyle.H5" />
<RadzenText Text="Templates are reusable starting values. Saving or archiving a template never changes existing bulletin items." TextStyle="TextStyle.Body2" />
<RadzenRow Gap="1rem"><RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Template name" Style="width:100%;"><ChildContent><RadzenTextBox @bind-Value="templateName" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn><RadzenColumn Size="12" SizeMD="3"><RadzenFormField Text="Default deadline (hours)" Style="width:100%;"><ChildContent><RadzenNumeric TValue="int?" @bind-Value="templateDeadlineHours" Min="1" Placeholder="Optional" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn><RadzenColumn Size="12" SizeMD="3"><RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".5rem" Style="margin-top:1.5rem"><RadzenCheckBox @bind-Value="templateUnique" /><RadzenText Text="Unique per user" /></RadzenStack></RadzenColumn></RadzenRow>
<RadzenFormField Text="Bulletin title" Style="width:100%;"><ChildContent><RadzenTextBox @bind-Value="templateTitle" Style="width:100%;" /></ChildContent></RadzenFormField>
<RadzenFormField Text="Description" Style="width:100%;"><ChildContent><RadzenTextArea @bind-Value="templateDescription" Rows="3" Style="width:100%;" /></ChildContent></RadzenFormField>
<RadzenRow Gap="1rem"><RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="DKP per quantity" Style="width:100%;"><ChildContent><RadzenNumeric @bind-Value="templateAmount" Min="1" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn><RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Maximum completions" Style="width:100%;"><ChildContent><RadzenNumeric @bind-Value="templateMax" Min="1" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn></RadzenRow>
<RadzenStack Orientation="Orientation.Horizontal" Gap=".5rem"><RadzenButton Text="@(templateEditingId is null ? "Save template" : "Save template changes")" Click="SaveTemplateAsync" Disabled="@saving" />@if (templateEditingId is not null) { <RadzenButton Text="Cancel template edit" Click="ResetTemplateForm" Disabled="@saving" ButtonStyle="ButtonStyle.Light" /> }</RadzenStack>
<RadzenDataGrid Data="@templates" TItem="BulletinTemplateDto" AllowPaging="true" AllowSorting="true" EmptyText="No templates."><Columns><RadzenDataGridColumn TItem="BulletinTemplateDto" Property="Name" Title="Name" /><RadzenDataGridColumn TItem="BulletinTemplateDto" Property="Title" Title="Title" /><RadzenDataGridColumn TItem="BulletinTemplateDto" Property="DkpAmount" Title="DKP" /><RadzenDataGridColumn TItem="BulletinTemplateDto" Property="MaxCompletions" Title="Maximum" /><RadzenDataGridColumn TItem="BulletinTemplateDto" Title="Status"><Template Context="template"><RadzenBadge Text="@(template.IsActive ? "Active" : "Inactive")" BadgeStyle="@(template.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" /></Template></RadzenDataGridColumn><RadzenDataGridColumn TItem="BulletinTemplateDto" Title="Actions"><Template Context="template"><RadzenButton Text="Edit" Click="@(() => BeginTemplateEdit(template))" Size="ButtonSize.Small" Disabled="@saving" /><RadzenButton Text="@(template.IsActive ? "Deactivate" : "Activate")" Click="@(() => ToggleTemplateAsync(template))" Size="ButtonSize.Small" Disabled="@saving" />@if (template.IsActive) { <RadzenButton Text="Archive" Click="@(() => ArchiveTemplateAsync(template))" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Disabled="@saving" /> }</Template></RadzenDataGridColumn></Columns></RadzenDataGrid>
</RadzenStack></RadzenCard>
</RadzenAccordionItem>
<RadzenAccordionItem Text="Create or edit bulletin item" Icon="add_task">
<RadzenCard><RadzenStack Gap=".75rem"><RadzenText Text="@(editingId is null ? "Create item" : "Edit item")" TextStyle="TextStyle.H5" />
@if (editingId is null) { <RadzenFormField Text="Start from template" Style="width:100%;"><ChildContent><RadzenDropDown TValue="Guid?" @bind-Value="selectedTemplateId" Data="@activeTemplates" TextProperty="Name" ValueProperty="Id" AllowClear="true" Change="OnTemplateChanged" Placeholder="Optional template" Style="width:100%;" /></ChildContent></RadzenFormField><RadzenText Text="Choose an active template to fill the fields below. You can change every value before publishing." TextStyle="TextStyle.Caption" /> } else { <RadzenText Text="Existing items have no template relationship. Editing this item does not change any template." TextStyle="TextStyle.Caption" /> }
<RadzenFormField Text="Title" Style="width:100%;"><ChildContent><RadzenTextBox @bind-Value="title" Placeholder="Short title shown to members" Style="width:100%;" /></ChildContent></RadzenFormField><RadzenFormField Text="Description" Style="width:100%;"><ChildContent><RadzenTextArea @bind-Value="description" Placeholder="Explain what the member must do" Rows="3" Style="width:100%;" /></ChildContent></RadzenFormField>
<RadzenRow Gap="1rem"><RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="DKP per quantity" Style="width:100%;"><ChildContent><RadzenNumeric @bind-Value="amount" Min="1" Placeholder="DKP amount" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn><RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Maximum completions" Style="width:100%;"><ChildContent><RadzenNumeric @bind-Value="max" Min="1" Placeholder="Total available quantity" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn><RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Deadline" Style="width:100%;"><ChildContent><RadzenDatePicker @bind-Value="deadline" DateFormat="yyyy-MM-dd HH:mm" Placeholder="Optional deadline" Style="width:100%;" /></ChildContent></RadzenFormField></RadzenColumn></RadzenRow>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".5rem"><RadzenCheckBox @bind-Value="unique" /><RadzenText Text="Unique per user" /></RadzenStack><RadzenText Text="When enabled, each member can claim this item only once and quantity is always 1." TextStyle="TextStyle.Caption" />
<RadzenStack Orientation="Orientation.Horizontal" Gap=".5rem"><RadzenButton Text="@(editingId is null ? "Create item" : "Save changes")" Click="SaveAsync" Disabled="@saving" />@if (editingId is not null) { <RadzenButton Text="Cancel edit" Click="ResetForm" Disabled="@saving" ButtonStyle="ButtonStyle.Light" /> }@if (editingId is null && selectedTemplateId is not null) { <RadzenButton Text="Clear template" Click="ClearTemplate" Disabled="@saving" ButtonStyle="ButtonStyle.Light" /> }</RadzenStack>
</RadzenStack></RadzenCard>
</RadzenAccordionItem>
<RadzenAccordionItem Text="Bulletin items" Icon="campaign">
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".5rem"><RadzenCheckBox @bind-Value="showHidden" /><RadzenText Text="Show hidden items" /></RadzenStack>
<RadzenDataGrid Data="@VisibleItems" TItem="BulletinItemDto" AllowPaging="true" AllowSorting="true" EmptyText="No bulletin items."><Columns><RadzenDataGridColumn TItem="BulletinItemDto" Property="Title" Title="Title" /><RadzenDataGridColumn TItem="BulletinItemDto" Property="DkpAmount" Title="DKP" /><RadzenDataGridColumn TItem="BulletinItemDto" Property="RemainingQuantity" Title="Remaining" /><RadzenDataGridColumn TItem="BulletinItemDto" Property="DeadlineUtc" Title="Deadline"><Template Context="item">@(item.DeadlineUtc?.ToLocalTime().ToString("g") ?? "No deadline")</Template></RadzenDataGridColumn><RadzenDataGridColumn TItem="BulletinItemDto" Title="Status"><Template Context="item"><RadzenStack Orientation="Orientation.Horizontal" Gap=".35rem"><RadzenBadge Text="@GetStatus(item)" BadgeStyle="@GetStatusStyle(item)" />@if (item.IsHidden) { <RadzenBadge Text="Hidden" BadgeStyle="BadgeStyle.Warning" /> }</RadzenStack></Template></RadzenDataGridColumn><RadzenDataGridColumn TItem="BulletinItemDto" Title="Actions"><Template Context="item"><RadzenButton Text="Edit" Click="@(() => BeginEdit(item))" Size="ButtonSize.Small" /><RadzenButton Text="@(item.IsActive ? "Deactivate" : "Activate")" Click="@(() => ToggleAsync(item))" Size="ButtonSize.Small" /><RadzenButton Text="@(item.IsHidden ? "Show" : "Hide")" Click="@(() => ToggleHiddenAsync(item))" Size="ButtonSize.Small" /></Template></RadzenDataGridColumn></Columns></RadzenDataGrid>
</RadzenAccordionItem>
<RadzenAccordionItem Text="Claims" Icon="fact_check">
<RadzenCard><RadzenText Text="Claims" TextStyle="TextStyle.H5" /><RadzenDataGrid Data="@claims" TItem="BulletinClaimDto" AllowPaging="true" AllowSorting="true" EmptyText="No claims."><Columns><RadzenDataGridColumn TItem="BulletinClaimDto" Property="DiscordName" Title="Player" /><RadzenDataGridColumn TItem="BulletinClaimDto" Property="BulletinTitle" Title="Item" /><RadzenDataGridColumn TItem="BulletinClaimDto" Property="Quantity" Title="Quantity" /><RadzenDataGridColumn TItem="BulletinClaimDto" Property="Status" Title="Status" /><RadzenDataGridColumn TItem="BulletinClaimDto" Title="Actions"><Template Context="claim">@if (claim.Status == BulletinClaimStatus.Pending) { <RadzenButton Text="Approve" Click="@(() => ReviewAsync(claim, true))" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" /><RadzenButton Text="Reject" Click="@(() => ReviewAsync(claim, false))" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" /> } else if (claim.Status == BulletinClaimStatus.Approved) { <RadzenButton Text="Revert" Click="@(() => RevertAsync(claim))" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" /> }</Template></RadzenDataGridColumn></Columns></RadzenDataGrid></RadzenCard>
</RadzenAccordionItem>
</Items></RadzenAccordion>
</RadzenStack>
@code {
    private IReadOnlyList<BulletinItemDto> items = []; private IReadOnlyList<BulletinClaimDto> claims = []; private IReadOnlyList<BulletinTemplateDto> templates = [];
    private IEnumerable<BulletinTemplateDto> activeTemplates => templates.Where(x => x.IsActive);
    private string title = string.Empty, description = string.Empty, templateName = string.Empty, templateTitle = string.Empty, templateDescription = string.Empty;
    private int amount = 1, max = 1, templateAmount = 1, templateMax = 1; private int? templateDeadlineHours;
    private bool unique, saving, showHidden, templateUnique; private DateTime? deadline; private Guid? editingId, selectedTemplateId, templateEditingId;
    private IEnumerable<BulletinItemDto> VisibleItems => items.Where(item => showHidden || !item.IsHidden);
    private string GetStatus(BulletinItemDto item) => item.DeadlineUtc is DateTime deadline && deadline <= DateTime.UtcNow ? "Expired" : item.RemainingQuantity == 0 && item.PendingQuantity == 0 ? "Inactive" : item.IsActive ? "Active" : "Inactive";
    private BadgeStyle GetStatusStyle(BulletinItemDto item) => GetStatus(item) == "Active" ? BadgeStyle.Success : GetStatus(item) == "Expired" ? BadgeStyle.Warning : BadgeStyle.Light;
    protected override async Task OnInitializedAsync() { try { await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to load bulletin administration", ex.Message); } }
    private async Task ReloadAsync() { items = await BulletinQueries.GetAllItemsAsync(); claims = await BulletinQueries.GetAllClaimsAsync(); templates = await TemplateQueries.GetAllAsync(); }
    private async Task SaveTemplateAsync() { if (saving) return; saving = true; try { TimeSpan? offset = templateDeadlineHours is int hours ? TimeSpan.FromHours(hours) : null; if (templateEditingId is Guid id) await TemplateCommands.UpdateAsync(id, new UpdateBulletinTemplateRequest(templateName, templateTitle, templateDescription, templateAmount, templateMax, templateUnique, offset)); else await TemplateCommands.CreateAsync(new CreateBulletinTemplateRequest(templateName, templateTitle, templateDescription, templateAmount, templateMax, templateUnique, offset)); ResetTemplateForm(); await ReloadAsync(); NotificationService.Notify(NotificationSeverity.Success, "Template saved", "The bulletin template was saved."); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to save template", ex.Message); } finally { saving = false; } }
    private void BeginTemplateEdit(BulletinTemplateDto template) { templateEditingId = template.Id; templateName = template.Name; templateTitle = template.Title; templateDescription = template.Description; templateAmount = template.DkpAmount; templateMax = template.MaxCompletions; templateUnique = template.UniquePerUser; templateDeadlineHours = template.DefaultDeadlineOffset is TimeSpan offset ? (int)offset.TotalHours : null; }
    private void ResetTemplateForm() { templateEditingId = null; templateName = templateTitle = templateDescription = string.Empty; templateAmount = templateMax = 1; templateUnique = false; templateDeadlineHours = null; }
    private async Task ToggleTemplateAsync(BulletinTemplateDto template) { try { await TemplateCommands.SetActiveAsync(template.Id, !template.IsActive); await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to update template", ex.Message); } }
    private async Task ArchiveTemplateAsync(BulletinTemplateDto template) { try { await TemplateCommands.ArchiveAsync(template.Id); await ReloadAsync(); NotificationService.Notify(NotificationSeverity.Success, "Template archived", "The template is no longer available for new items."); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to archive template", ex.Message); } }
    private void OnTemplateChanged(object value) { selectedTemplateId = value is Guid id ? id : null; var template = selectedTemplateId is Guid selected ? activeTemplates.FirstOrDefault(x => x.Id == selected) : null; if (template is null) return; title = template.Title; description = template.Description; amount = template.DkpAmount; max = template.MaxCompletions; unique = template.UniquePerUser; deadline = template.DefaultDeadlineOffset is TimeSpan offset ? DateTime.UtcNow.Add(offset).ToLocalTime() : null; }
    private void ClearTemplate() { selectedTemplateId = null; ResetFormValues(); }
    private async Task SaveAsync() { if (saving) return; saving = true; try { if (editingId is Guid id) await BulletinCommands.UpdateItemAsync(id, new UpdateBulletinItemRequest(title, description, amount, max, unique, deadline?.ToUniversalTime())); else await BulletinCommands.CreateItemAsync(new CreateBulletinItemRequest(title, description, amount, max, unique, deadline?.ToUniversalTime(), selectedTemplateId)); ResetForm(); NotificationService.Notify(NotificationSeverity.Success, "Bulletin item saved", "The bulletin item was saved."); await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to save bulletin item", ex.Message); } finally { saving = false; } }
    private void BeginEdit(BulletinItemDto item) { editingId = item.Id; selectedTemplateId = null; title = item.Title; description = item.Description; amount = item.DkpAmount; max = item.MaxCompletions; unique = item.UniquePerUser; deadline = item.DeadlineUtc?.ToLocalTime(); }
    private void ResetFormValues() { title = string.Empty; description = string.Empty; amount = 1; max = 1; unique = false; deadline = null; }
    private void ResetForm() { editingId = null; selectedTemplateId = null; ResetFormValues(); }
    private async Task ToggleAsync(BulletinItemDto item) { try { await BulletinCommands.SetItemActiveAsync(item.Id, !item.IsActive); await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to update bulletin item", ex.Message); } }
    private async Task ToggleHiddenAsync(BulletinItemDto item) { try { await BulletinCommands.SetItemHiddenAsync(item.Id, !item.IsHidden); await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to hide/show bulletin item", ex.Message); } }
    private async Task ReviewAsync(BulletinClaimDto claim, bool approve) { try { if (approve) await BulletinCommands.ApproveClaimAsync(claim.Id, new ReviewBulletinClaimRequest(null)); else await BulletinCommands.RejectClaimAsync(claim.Id, new ReviewBulletinClaimRequest(null)); await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to review claim", ex.Message); } }
    private async Task RevertAsync(BulletinClaimDto claim) { try { await BulletinCommands.RevertApprovedClaimAsync(claim.Id, new ReviewBulletinClaimRequest("Approved bulletin claim reverted by Officer.")); NotificationService.Notify(NotificationSeverity.Success, "Claim reverted", "The DKP award was reversed."); await ReloadAsync(); } catch (Exception ex) { NotificationService.Notify(NotificationSeverity.Error, "Unable to revert claim", ex.Message); } }
}
