@page "/"
@attribute [Authorize]
@using DKP.Facade.Commands
@using DKP.Facade.Contracts
@using DKP.Facade.Queries
@inject IAccountQueries AccountQueries
@inject ICharacterCommands CharacterCommands
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Dashboard</PageTitle>

@if (loading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 16rem;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText Text="Loading dashboard..." />
    </RadzenStack>
}
else if (dashboard is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">Unable to load your dashboard. Please reload the page.</RadzenAlert>
}
else
{
    <RadzenStack Gap="1.5rem">
        <div>
            <h1>Dashboard</h1>
            <RadzenText Text="Your guild DKP overview" TextStyle="TextStyle.Subtitle2" />
        </div>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard>
                    <RadzenText Text="Current DKP" TextStyle="TextStyle.Overline" />
                    <RadzenText Text="@dashboard.DkpBalance.ToString("0")" Style="font-size: 2.5rem; font-weight: 700;" />
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard>
                    <RadzenText Text="Discord" TextStyle="TextStyle.Overline" />
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        @if (dashboard.AvatarUrl is not null)
                        {
                            <RadzenImage Path="@dashboard.AvatarUrl" Style="width: 3rem; height: 3rem; border-radius: 50%;" />
                        }
                        <RadzenText Text="@dashboard.DiscordName" Style="font-size: 1.25rem;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard>
                    <RadzenText Text="Characters" TextStyle="TextStyle.Overline" />
                    <RadzenText Text="@dashboard.Characters.Count.ToString()" Style="font-size: 2.5rem; font-weight: 700;" />
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem">
                <div>
                    <RadzenText Text="Active purchases" TextStyle="TextStyle.H5" />
                    <RadzenText Text="See your SoftReserve, RollBonus and other active shop items." />
                </div>
                <RadzenButton Text="View my purchases" Icon="shopping_bag" ButtonStyle="ButtonStyle.Primary" Click="GoToPurchases" />
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText Text="Your characters" TextStyle="TextStyle.H5" />
                <RadzenDataGrid Data="@dashboard.Characters" AllowPaging="true" PageSize="5" AllowSorting="true" EmptyText="No characters yet.">
                    <Columns>
                        <RadzenDataGridColumn TItem="CharacterDto" Property="FirstName" Title="First name">
                            <Template Context="character">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    @if (character.IsMain)
                                    {
                                        <RadzenText Text="⭐" />
                                    }
                                    <RadzenText Text="@character.FirstName" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CharacterDto" Property="LastName" Title="Last name" />
                        <RadzenDataGridColumn TItem="CharacterDto" Title="Actions" Sortable="false" Filterable="false">
                            <Template Context="character">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    @if (character.IsMain)
                                    {
                                        <RadzenBadge Text="Main" BadgeStyle="BadgeStyle.Success" />
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Set as main" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => SetMainAsync(character))" Disabled="@saving" />
                                    }
                                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => BeginEdit(character))" Disabled="@saving" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeleteAsync(character))" Disabled="@saving" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenText Text="@(editingId is null ? "Add character" : "Edit character")" TextStyle="TextStyle.H5" />
            <RadzenTemplateForm TItem="CharacterForm" Data="@form" Submit="@SaveAsync" Style="margin-top: 1rem;">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="First name" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="FirstName" @bind-Value="form.FirstName" Style="width: 100%;" MaxLength="64" Disabled="@saving" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="Last name" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="LastName" @bind-Value="form.LastName" Style="width: 100%;" MaxLength="64" Disabled="@saving" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2" Style="display:flex; align-items:end; gap:.5rem;">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@saving" />
                        @if (editingId is not null)
                        {
                            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelEdit" Disabled="@saving" />
                        }
                    </RadzenColumn>
                </RadzenRow>
            </RadzenTemplateForm>
        </RadzenCard>
    </RadzenStack>
}

@code {
    private DashboardDto? dashboard;
    private readonly CharacterForm form = new();
    private Guid? editingId;
    private bool saving;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Unable to load dashboard", exception.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ReloadAsync() =>
        dashboard = await AccountQueries.GetDashboardAsync()
            ?? throw new InvalidOperationException("Your dashboard could not be loaded.");

    private void BeginEdit(CharacterDto character)
    {
        if (saving) return;
        editingId = character.Id;
        form.FirstName = character.FirstName;
        form.LastName = character.LastName;
    }

    private void CancelEdit()
    {
        editingId = null;
        form.FirstName = string.Empty;
        form.LastName = string.Empty;
    }

    private async Task SaveAsync(CharacterForm _)
    {
        if (saving) return;
        saving = true;
        try
        {
            if (editingId is Guid id)
            {
                if (await CharacterCommands.UpdateAsync(id, new CharacterInput(form.FirstName, form.LastName)) is null)
                    throw new InvalidOperationException("The character no longer exists.");
                NotificationService.Notify(NotificationSeverity.Success, "Saved", "Character updated.");
            }
            else
            {
                await CharacterCommands.CreateAsync(new CharacterInput(form.FirstName, form.LastName));
                NotificationService.Notify(NotificationSeverity.Success, "Saved", "Character added.");
            }

            CancelEdit();
            await MutationFeedback.RefreshAsync(ReloadAsync, NotificationService);
        }
        catch (ArgumentException exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Validation error", exception.Message);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Unable to save", exception.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(CharacterDto character)
    {
        if (saving) return;
        saving = true;
        try
        {
            var confirmed = await DialogService.Confirm($"Delete {character.FirstName} {character.LastName}?", "Confirm deletion", new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
            if (confirmed != true) return;

            if (!await CharacterCommands.DeleteAsync(character.Id))
                throw new InvalidOperationException("The character no longer exists.");

            if (editingId == character.Id) CancelEdit();
            NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Character removed.");
            await MutationFeedback.RefreshAsync(ReloadAsync, NotificationService);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Unable to delete character", exception.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SetMainAsync(CharacterDto character)
    {
        if (saving) return;
        saving = true;
        try
        {
            if (!await CharacterCommands.SetMainCharacterAsync(character.Id))
                throw new InvalidOperationException("The character no longer exists.");

            NotificationService.Notify(NotificationSeverity.Success, "Main character updated", $"{character.FirstName} {character.LastName} is now your main character.");
            await MutationFeedback.RefreshAsync(ReloadAsync, NotificationService);
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Unable to set main character", exception.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private void GoToPurchases() => NavigationManager.NavigateTo("/my-purchases");

    private sealed class CharacterForm
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
    }
}
