@page "/admin/discord-forum"
@attribute [Authorize(Roles = "Officer")]
@using DKP.Facade.Commands
@using DKP.Facade.Contracts
@using DKP.Facade.Queries
@inject IDiscordForumSectionQueries Queries
@inject IDiscordForumSectionCommands Commands
@inject IDiscordForumProvisionCommands ProvisionCommands
@inject IDiscordForumProvisionQueries ProvisionQueries
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Discord Forum</PageTitle>
<RadzenStack Gap="1rem">
    <div><h1>Discord Forum sections</h1><RadzenText Text="Edit messages and manually provision replacement threads. The bot never creates forum threads automatically." /></div>
    @foreach (var section in sections)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenText Text="@SectionTitle(section.SectionKey)" TextStyle="TextStyle.H5" />
                    <RadzenText Text="@Status(section)" />
                </RadzenStack>
                <RadzenTextArea @bind-Value="drafts[section.SectionKey]" Rows="5" MaxLength="4000" Style="width:100%;" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Save initial message" Icon="save" Click="@(() => SaveAsync(section))" Disabled="@busy" />
                    <RadzenButton Text="Create new thread" Icon="add_comment" ButtonStyle="ButtonStyle.Warning" Click="@(() => ProvisionAsync(section))" Disabled="@busy" />
                    <RadzenButton Text="Reload" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="ReloadAsync" Disabled="@busy" />
                </RadzenStack>
                <RadzenText Text="@SectionInfo(section)" TextStyle="TextStyle.Caption" />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private IReadOnlyList<DiscordForumSectionDto> sections = [];
    private readonly Dictionary<string, string> drafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, DiscordForumProvisionDto?> provisionStatus = new(StringComparer.OrdinalIgnoreCase);
    private bool busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        sections = await Queries.GetAllAsync();
        drafts.Clear();
        provisionStatus.Clear();
        foreach (var section in sections)
        {
            drafts[section.SectionKey] = section.InitialMessageContent;
            provisionStatus[section.SectionKey] = await ProvisionQueries.GetLatestAsync(section.GuildId, section.SectionKey);
        }
    }

    private async Task SaveAsync(DiscordForumSectionDto section)
    {
        if (busy) return;
        busy = true;
        try
        {
            await Commands.UpdateContentAsync(section.SectionKey, new UpdateDiscordForumSectionRequest(drafts[section.SectionKey]));
            await ReloadAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Saved", "The Discord initial message was updated.");
        }
        catch (Exception exception) { NotificationService.Notify(NotificationSeverity.Error, "Unable to save", exception.Message); }
        finally { busy = false; }
    }

    private static string SectionTitle(string key) => key switch
    {
        "bulletin-board" => "Bulletin Board",
        "achievements" => "Achievements",
        "dkp-sources" => "Repeatable DKP",
        "shop" => "Shop",
        "bot-help" => "Bot Help",
        _ => key
    };

    private string Status(DiscordForumSectionDto section)
    {
        var request = provisionStatus.GetValueOrDefault(section.SectionKey);
        return request?.Status switch
        {
            DiscordForumProvisionStatus.Pending => "Pending",
            DiscordForumProvisionStatus.Processing => "Processing",
            DiscordForumProvisionStatus.Failed => "Failed",
            _ => section.ThreadId is null ? "Missing" : "Active"
        };
    }
    private static string SectionInfo(DiscordForumSectionDto section) => $"Thread: {section.ThreadId?.ToString() ?? "Not created"} | Message: {section.InitialMessageId?.ToString() ?? "Not registered"} | Updated: {(section.UpdatedAtUtc == DateTime.MinValue ? "Never" : section.UpdatedAtUtc.ToString("u"))}";

    private async Task ProvisionAsync(DiscordForumSectionDto section)
    {
        if (busy || await DialogService.Confirm($"Create a new {SectionTitle(section.SectionKey)} thread and archive the current one if it exists?", "Confirm thread replacement") != true) return;
        busy = true;
        try
        {
            await ProvisionCommands.RequestAsync(section.SectionKey);
            await ReloadAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Provision requested", "The bot will create the new thread shortly.");
        }
        catch (Exception exception) { NotificationService.Notify(NotificationSeverity.Error, "Unable to request thread", exception.Message); }
        finally { busy = false; }
    }
}
