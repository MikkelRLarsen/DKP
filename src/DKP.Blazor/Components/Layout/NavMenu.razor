<RadzenPanelMenu Style="width: 100%;">
    <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" />
    <AuthorizeView>
        <Authorized>
            <RadzenPanelMenuItem Text="My DKP" Icon="account_balance_wallet" Path="/my-dkp" />
            <RadzenPanelMenuItem Text="My Purchases" Icon="shopping_bag" Path="/my-purchases" />
            <RadzenPanelMenuItem Text="DKP Shop" Icon="shopping_cart" Path="/dkp-shop" />
            <RadzenPanelMenuItem Text="Guild Members" Icon="groups" Path="/members" />
            <AuthorizeView Roles="Officer">
                <Authorized Context="officerContext">
                    <RadzenPanelMenuItem Text="Administration" Icon="admin_panel_settings">
                        <RadzenPanelMenuItem Text="Overview" Icon="dashboard" Path="/admin" />
                        <RadzenPanelMenuItem Text="DKP Management" Icon="account_balance_wallet" Path="/admin/dkp" />
                        <RadzenPanelMenuItem Text="DKP Presets" Icon="rule" Path="/admin/dkp-presets" />
                        <RadzenPanelMenuItem Text="Shop Catalog" Icon="storefront" Path="/admin/shop" />
                        <RadzenPanelMenuItem Text="Shop Purchases" Icon="shopping_bag" Path="/admin/shop/purchases" />
                        <RadzenPanelMenuItem Text="User Management" Icon="manage_accounts" Path="/admin/users" />
                        <RadzenPanelMenuItem Text="LootReserve Export" Icon="file_copy" Path="/admin/loot-reserve" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <RadzenPanelMenuItem Text="Login" Icon="login" Path="/account/login" />
        </NotAuthorized>
    </AuthorizeView>
</RadzenPanelMenu>
