@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; padding: 0 1.25rem;">
            <RadzenText Text="Guild DKP" Style="font-size: 1.25rem; font-weight: 700;" />
            <AuthorizeView>
                <Authorized>
                    <RadzenButton Text="Logout" Icon="logout" ButtonStyle="ButtonStyle.Light" Path="/account/logout" />
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar>
        <NavMenu />
    </RadzenSidebar>
    <RadzenBody>
        <div class="content px-4 py-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<RadzenDialog />
<RadzenNotification />
