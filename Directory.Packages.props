<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- Dapr -->
		<PackageVersion Include="Dapr.Client" Version="1.17.9" />
		<PackageVersion Include="Dapr.AspNetCore" Version="1.17.9" />
		<PackageVersion Include="Dapr.Workflow" Version="1.16.1" />

		<!-- Entity Framework Core -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.4" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.4" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />

		<!-- PostgreSQL provider -->
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

		<!-- Other -->
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
		<PackageVersion Include="Scalar.AspNetCore" Version="2.14.6" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />

		<!-- Testing -->
		<PackageVersion Include="coverlet.collector" Version="10.0.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
	</ItemGroup>
</Project>